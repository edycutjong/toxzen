# ── Google AI (Gemini Flash) ──────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Set via Devvit CLI: npx devvit settings set geminiApiKey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Devvit ───────────────────────────────────────────────────
# Devvit uses its own settings system (devvit.json → settings.global)
# API keys are NOT stored in .env — they go through the Devvit CLI:
#   npx devvit settings set geminiApiKey
#
# .env is only read during local playtesting (not in production).
# See: https://developers.reddit.com/docs/capabilities/server/settings-and-secrets
