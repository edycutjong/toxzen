{
  "name": "toxzen-app",
  "version": "0.0.0",
  "private": true,
  "description": "AI-shielded ban appeal processor for Reddit moderators",
  "type": "module",
  "scripts": {
    "dev": "npx devvit playtest",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@devvit/start": "0.13.2",
    "@devvit/web": "0.13.11",
    "hono": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5"
  },
  "license": "BSD-3-Clause"
}
