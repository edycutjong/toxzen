    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.9.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "protobufjs": "^7.5.8"
  },
